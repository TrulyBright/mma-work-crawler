{
    "navigationFallback": {
      "rewrite": "/index.html",
      "exclude": ["/assets/*", "/data/*"]
    },
    "routes": [
      {
        "route": "/assets/*",
        "headers": { "cache-control": "public, max-age=31536000, immutable" }
      },
      {
        "route": "/data/*",
        "headers": { "cache-control": "public, max-age=31536000, immutable" }
      }
    ],
    "mimeTypes": {
      ".bin": "application/octet-stream",
      ".raw": "application/octet-stream"
    }
}
