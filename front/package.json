{
  "name": "front",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=18",
    "pnpm": ">=9"
  },
  "type": "module",
  "scripts": {
    "update-data": "node update-data.js",
    "dev": "vite",
    "build": "tsc && tsc -p tsconfig.node.json && vite build",
    "build-with-data": "pnpm run update-data && pnpm run build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  }
}
